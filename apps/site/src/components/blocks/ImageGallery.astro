---
import Img from '../Img.astro';
import Title from '../Title.astro';
const { data, ctx } = Astro.props;
const images = (data.images || []).filter((i) => ctx.media.get(i.image));
const logos = data.variant === 'logo_strip';
---
<section class="section">
  <div class="container">
    <Title heading={data.heading} center />
    {images.length === 0 ? null : logos ? (
      <div class="logo-strip">
        {images.map((i) => (i.link ? <a href={i.link} rel="noopener"><Img id={i.image} media={ctx.media} alt={i.caption || undefined} /></a> : <Img id={i.image} media={ctx.media} alt={i.caption || undefined} />))}
      </div>
    ) : (
      <div class="gallery">
        {images.map((i) => (
          <figure>
            {i.link ? <a href={i.link}><Img id={i.image} media={ctx.media} /></a> : <Img id={i.image} media={ctx.media} />}
            {i.caption && <figcaption>{i.caption}</figcaption>}
          </figure>
        ))}
      </div>
    )}
  </div>
</section>
