---
const { name, badge: asBadge = false } = Astro.props;
const paths = {
  facebook: 'M14 8h3V4h-3c-2.8 0-4 1.8-4 4.3V10H7v4h3v8h4v-8h3l1-4h-4V8.5c0-.3.2-.5.5-.5z',
  instagram: 'M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4zm5 5a4 4 0 1 0 0 8 4 4 0 0 0 0-8zm5.5-1.5a1 1 0 1 0 0 2 1 1 0 0 0 0-2z',
  youtube: 'M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.8 1.8c1.6.4 7.8.4 7.8.4s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8zM10 15V9l5.2 3z',
  phone: 'M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.2 11.4 11.4 0 0 0 3.6.6 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.3.2 2.5.6 3.6a1 1 0 0 1-.3 1z',
  mail: 'M3 5h18v14H3zm0 1 9 7 9-7',
  pin: 'M12 21s-7-6.5-7-12a7 7 0 0 1 14 0c0 5.5-7 12-7 12zm0-9a3 3 0 1 0 0-6 3 3 0 0 0 0 6z',
};
const filled = ['facebook', 'instagram', 'youtube', 'phone', 'pin'].includes(name);
// Social links render as round badges like the old site: a currentColor disc with the
// brand mark in the background colour (--badge-cutout) so it reads as cut out.
// Contact icons (pin, phone, mail) use the same badge style when `badge` is passed, as in
// the old site's top bar, footer and contact card.
const badge = ['facebook', 'instagram', 'youtube'].includes(name) || (asBadge && ['pin', 'phone', 'mail'].includes(name));
---
{badge ? (
  <svg viewBox="0 0 24 24" aria-hidden="true" class="badge">
    <circle cx="12" cy="12" r="12" fill="currentColor" />
    {name === 'facebook' && <path fill="var(--badge-cutout)" d="M13.3 24v-8.7h2.9l.45-3.4H13.3V9.7c0-1 .28-1.66 1.7-1.66h1.8V5a24 24 0 0 0-2.63-.13c-2.6 0-4.38 1.59-4.38 4.5v2.5H6.85v3.4h2.94V24z" />}
    {name === 'instagram' && (
      <g fill="none" stroke="var(--badge-cutout)" stroke-width="1.7">
        <rect x="6.4" y="6.4" width="11.2" height="11.2" rx="3.3" />
        <circle cx="12" cy="12" r="2.7" />
        <circle cx="15.4" cy="8.6" r=".45" fill="var(--badge-cutout)" />
      </g>
    )}
    {name === 'pin' && (
      <>
        <path fill="var(--badge-cutout)" d="M12 4.6a4.6 4.6 0 0 0-4.6 4.6c0 3.4 4.6 7.9 4.6 7.9s4.6-4.5 4.6-7.9A4.6 4.6 0 0 0 12 4.6z" />
        <circle cx="12" cy="9.2" r="1.7" fill="currentColor" />
        <ellipse cx="12" cy="18.6" rx="3.4" ry="0.9" fill="var(--badge-cutout)" />
      </>
    )}
    {name === 'phone' && <path fill="var(--badge-cutout)" transform="translate(5.6 5.6) scale(0.54)" d={paths.phone} />}
    {name === 'mail' && (
      <g fill="none" stroke="var(--badge-cutout)" stroke-width="1.3" stroke-linejoin="round">
        <rect x="6" y="8" width="12" height="8.4" />
        <path d="M6 8l6 5 6-5" />
      </g>
    )}
    {name === 'youtube' && (
      <>
        <rect x="5" y="7.5" width="14" height="9" rx="2.6" fill="var(--badge-cutout)" />
        <path d="M10.6 9.9v4.2l3.6-2.1z" fill="currentColor" />
      </>
    )}
  </svg>
) : (
  <svg viewBox="0 0 24 24" aria-hidden="true" fill={filled ? 'currentColor' : 'none'} stroke={filled ? 'none' : 'currentColor'} stroke-width="1.6" fill-rule="evenodd"><path d={paths[name]} /></svg>
)}
