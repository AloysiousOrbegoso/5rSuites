---
// Fonts are self-hosted (bundled from npm) — no Google Fonts dependency.
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '@fontsource/poppins/800.css';
import '@5rsuites/design/styles.css';
import { env } from 'cloudflare:workers';
import SocialIcon from '../components/SocialIcon.astro';
import { siteInfo } from '../lib/site-info.js';

const { title, description = '', nav = [], currentSlug = '', jsonLd = [], noindex = false, shareImage = null } = Astro.props;
const info = Astro.props.info ?? (await siteInfo(env));
const canonical = new URL(Astro.url.pathname, info.siteUrl).toString().replace(/\/$/, '') || info.siteUrl;
const fullTitle = currentSlug === 'home' ? '5R Suites | Luxury Fully-Furnished Apartments' : `${title} | 5R Suites`;
const ga = env.GA4_MEASUREMENT_ID;
const year = new Date().getFullYear();
const tel = `tel:${info.phone.replace(/[^\d+]/g, '')}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="5R Suites" />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    {shareImage && (
      <>
        <meta property="og:image" content={shareImage.url} />
        {shareImage.width && <meta property="og:image:width" content={String(shareImage.width)} />}
        {shareImage.height && <meta property="og:image:height" content={String(shareImage.height)} />}
        {shareImage.alt && <meta property="og:image:alt" content={shareImage.alt} />}
      </>
    )}
    <meta name="twitter:card" content={shareImage ? 'summary_large_image' : 'summary'} />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />)}
    {ga && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga}`}></script>
        <script is:inline define:vars={{ ga }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', ga);
        </script>
      </>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="topbar">
      <div class="container">
        {info.mailingAddress && <span class="item left"><SocialIcon name="pin" badge />Mailing Address: {info.mailingAddress}</span>}
        <span class="right">
          {info.phone && <a class="item" href={tel}><SocialIcon name="phone" badge />Phone: {info.phone}</a>}
          {info.email && <a class="item" href={`mailto:${info.email}`}><SocialIcon name="mail" badge />Email: {info.email}</a>}
        </span>
      </div>
    </div>
    <header class="site-header">
      <div class="container bar">
        <a href="/" class="brand" aria-label="5R Suites home">
          <img src="/logo.png" alt="" width="77" height="77" />
          <span><span class="name">5R SUITES</span><span class="tagline">Luxury Fully-Furnished Apartments</span></span>
        </a>
        <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Menu">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
        </button>
        <nav id="site-nav" class="nav" aria-label="Main">
          {nav.map((item) => <a href={item.href} aria-current={item.slug === currentSlug ? 'page' : undefined}>{item.title}</a>)}
          <a href={info.bookingUrl} class="btn btn-outline">Book Now</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-top">
          <a href="/" class="brand">
            <img src="/logo.png" alt="" width="77" height="77" />
            <span><span class="name">5R SUITES</span><span class="tagline">Luxury Fully-Furnished Apartments</span></span>
          </a>
          <div class="contact">
            <div class="socials">
              {info.socials.map((s) => <a href={s.url} rel="noopener" target="_blank" aria-label={s.label}><SocialIcon name={s.name} /></a>)}
            </div>
            {info.phone && <a href={tel}><SocialIcon name="phone" badge />Phone: {info.phone}</a>}
            {info.email && <a href={`mailto:${info.email}`}><SocialIcon name="mail" badge />Email: {info.email}</a>}
          </div>
        </div>
        <div class="footer-mid">
          <span class="address">{info.mailingAddress && <><SocialIcon name="pin" badge />Mailing Address: {info.mailingAddress}</>}</span>
          <nav class="footer-nav" aria-label="Footer">
            {nav.map((item) => <a href={item.href} aria-current={item.slug === currentSlug ? 'page' : undefined}>{item.title}</a>)}
          </nav>
        </div>
        <div class="footer-bottom">
          <span>© {year} by 5R Suites All Rights Reserved</span>
          <div class="right">
            <div class="badges">
              <img src="/badges/chpa.png" alt="Corporate Housing Providers Association member" width="96" height="47" loading="lazy" />
              <img src="/badges/sdvosb.png" alt="Service-Disabled Veteran-Owned Small Business" width="58" height="54" loading="lazy" />
            </div>
            <nav aria-label="Legal">
              {info.privacyUrl && <a href={info.privacyUrl}>Privacy Policy</a>}
              {info.termsUrl && <a href={info.termsUrl}>Terms &amp; Condition</a>}
            </nav>
          </div>
        </div>
      </div>
    </footer>

    <script is:inline>
      // Scroll reveals: [data-reveal] elements are hidden (via .motion, per the section's
      // entrance animation) and get .in as they enter the viewport. Inline and at the end of
      // <body> so it runs before first paint.
      (() => {
        if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
        document.documentElement.classList.add('motion');

        // Scroll-linked photo motion, as on the old site:
        //   parallax: background drifts at a fifth of the scroll speed
        //   pan:      collage photo slides sideways across its frame as the section passes
        const parallax = [...document.querySelectorAll('img[data-effect="parallax"]')];
        const pan = [...document.querySelectorAll('img[data-effect="pan"]')];
        if (!parallax.length && !pan.length) return;
        let queued = false;
        const update = () => {
          queued = false;
          const vh = innerHeight;
          for (const img of parallax) {
            const r = img.parentElement.getBoundingClientRect();
            if (r.bottom < 0 || r.top > vh) continue;
            img.style.transform = `translate3d(0, ${(-0.8 * r.top).toFixed(1)}px, 0)`;
          }
          for (const img of pan) {
            const r = img.parentElement.getBoundingClientRect();
            if (r.bottom < 0 || r.top > vh) continue;
            const progress = Math.max(-1, Math.min(1, (vh / 2 - (r.top + r.height / 2)) / vh));
            img.style.transform = `translate3d(${(progress * r.width * (Number(img.dataset.pan) || 0.1)).toFixed(1)}px, 0, 0)`;
          }
        };
        const schedule = () => { if (!queued) { queued = true; requestAnimationFrame(update); } };
        addEventListener('scroll', schedule, { passive: true });
        addEventListener('resize', schedule, { passive: true });
        update();
      })();
    </script>
    {!noindex && (
      <script is:inline>
        // Page-view count for the admin's Analytics screen (first-party, no cookies; see
        // lib/analytics.js). Skipped for Do Not Track and automated browsers.
        (() => {
          if (navigator.doNotTrack === '1' || navigator.webdriver) return;
          const body = JSON.stringify({ p: location.pathname, q: location.search, r: document.referrer, h: location.hostname, w: innerWidth });
          try { fetch('/api/hit', { method: 'POST', body, keepalive: true, headers: { 'Content-Type': 'application/json' } }).catch(() => {}); } catch {}
        })();
      </script>
    )}
    <script>
      const toggle = document.querySelector('.nav-toggle');
      const nav = document.getElementById('site-nav');
      toggle?.addEventListener('click', () => {
        const open = nav.classList.toggle('open');
        toggle.setAttribute('aria-expanded', String(open));
      });
    </script>
  </body>
</html>
