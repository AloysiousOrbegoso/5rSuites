// Cloudflare Worker: www.5rsuites.com (public site)
// Connect this repo in Workers Builds with root directory apps/site.
// Build command: npm run build   Deploy command: npx wrangler deploy
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "5rsuites-site",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // "main" and "assets" are filled in by @astrojs/cloudflare at build time.

  // Edge cache in front of the Worker. Pages are cached until an admin save purges
  // their Cache-Tag (POST /api/internal/purge).
  "cache": { "enabled": true },

  "observability": { "enabled": true },

  "vars": {
    "SITE_URL": "https://www.5rsuites.com",
    "EMAIL_FROM": "5R Suites <no-reply@5rsuites.com>",
    "BOOKING_URL": "https://5rsuites.holidayfuture.com",
    // Shown in the top bar and footer.
    "CONTACT_PHONE": "360-320-6166",
    "CONTACT_EMAIL": "info@5rsuites.com",
    "MAILING_ADDRESS": "9330 NE Van Mall Drive Suite 203 #122",
    "FACEBOOK_URL": "https://www.facebook.com/stay5R",
    "INSTAGRAM_URL": "https://www.instagram.com/5rsuites/",
    "YOUTUBE_URL": "https://www.youtube.com/@5rsuites641",
    // Leave empty to hide the links until the pages exist (add them as CMS pages, e.g. /privacy-policy).
    "PRIVACY_URL": "",
    "TERMS_URL": "",
    // Link emailed with the Register Property report (e.g. a Cal.com / Google booking page).
    "SCHEDULING_URL": "",
    // Public Turnstile site key. The default is Cloudflare's always-pass test key — replace for production.
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    // GA4 Measurement ID (G-XXXXXXX). Leave empty until the client's GA4 property exists.
    "GA4_MEASUREMENT_ID": "",
    // How long city-level AirROI market figures are reused before being refreshed.
    "MARKET_CACHE_DAYS": "365"
  },

  // Same D1 database and R2 bucket as the admin (apps/admin/wrangler.toml).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "5rsuites",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../migrations"
    }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "5rsuites-media" }],

  "routes": [{ "pattern": "www.5rsuites.com", "custom_domain": true }]

  // Secrets (wrangler secret put <NAME>; never commit):
  //   RESEND_API_KEY, TURNSTILE_SECRET_KEY, TEAM_ALERT_EMAIL, PURGE_SECRET,
  //   FORM_NOTIFY_EMAIL (optional, defaults to TEAM_ALERT_EMAIL), AIRROI_API_KEY
}
